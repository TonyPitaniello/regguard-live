# ==========================================
# REGGUARD BACKEND ENVIRONMENT VARIABLES
# ==========================================
# SECURITY: Never commit real values to GitHub
# Copy this file to .env and fill in your actual values
# .env is protected by .gitignore

# ==========================================
# STRIPE PAYMENT PROCESSING (PHASE 1)
# ==========================================
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# Stripe Price IDs for tiers (create in Stripe Dashboard → Products)
# partner: $79/mo subscription (price_id optional; recurring price_data fallback)
# contractor_pro: $149/mo subscription
# ic_project: $1,500 one-time payment (price_id optional; falls back to price_data)
# ic_annual: $15,000/year subscription
# sponsor: $1,500/mo subscription
STRIPE_PRICE_PARTNER=price_XXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_CONTRACTOR_PRO=price_XXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_IC_PROJECT=price_XXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_IC_ANNUAL=price_XXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_SPONSOR=price_XXXXXXXXXXXXXXXXXXXX

# Cron: POST /cron/weekly-job-reminders with header X-Cron-Secret
# Example (cron-job.org weekly): POST https://regguard-api.onrender.com/cron/weekly-job-reminders
# Also daily: POST /cron/day7-win-emails
CRON_SECRET=change-me-long-random

# Admin: GET /admin/affiliates + POST /admin/affiliates/mark-paid (header X-Admin-Secret)
ADMIN_SECRET=change-me-long-random

# Free-tier COGS: light tip email by default; set 1 for full digest+Option A background email
FREE_TRIAL_HEAVY_EMAIL=0
# Free in-app Option A timeout (seconds)
FREE_TRIAL_ANALYSIS_TIMEOUT_SEC=15
# Weekly digest: flag Saved Jobs older than N days as "needs re-check"
JOB_STALE_DAYS=7

# Optional: run migrations/015_partner_affiliates.sql in Supabase for partner tier CHECK + affiliate tables

# ==========================================
# SUPABASE AUTHENTICATION (PHASE 2)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# ==========================================
# APPLICATION URLS
# ==========================================
BACKEND_URL=https://regguard-api.onrender.com
FRONTEND_URL=https://regguardagent.com
FRONTEND_APP_URL=https://app.regguardagent.com

# ==========================================
# API KEYS (Get from respective services)
# ==========================================
GEMINI_API_KEY=XXXXXXXXXXXXXXXXXXXX
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXX
FIRECRAWL_API_KEY=XXXXXXXXXXXXXXXXXXXX

# ==========================================
# SERVER CONFIGURATION
# ==========================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# ==========================================
# ERROR TRACKING (Optional)
# ==========================================
SENTRY_DSN=https://your-sentry-key@o123456.ingest.sentry.io/123456

# ==========================================
# EMAIL SERVICE
# ==========================================
RESEND_FROM_EMAIL=noreply@regguardagent.com
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# ==========================================
# SMS SERVICE (TWILIO)
# ==========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

